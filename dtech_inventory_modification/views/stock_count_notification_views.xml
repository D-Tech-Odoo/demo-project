<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_count_notification_form" model="ir.ui.view">
        <field name="name">stock.count.notification.form</field>
        <field name="model">stock.count.notification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="count_date"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="before_day_id"/>
                        <field name="email_template_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List View -->
    <record id="view_stock_count_notification_list" model="ir.ui.view">
        <field name="name">stock.count.notification.list</field>
        <field name="model">stock.count.notification</field>
        <field name="arch" type="xml">
            <list>
                <field name="count_date"/>
                <field name="before_day_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="email_template_id"/>
            </list>
        </field>
    </record>


    <!-- Action -->
    <record id="action_stock_count_notification" model="ir.actions.act_window">
        <field name="name">Stock Count Notification</field>
        <field name="res_model">stock.count.notification</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_stock_count_notification" name="Stock Count Notification" parent="stock.menu_warehouse_config"
              action="action_stock_count_notification"/>

</odoo>