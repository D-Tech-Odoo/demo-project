<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_category_form_inherit_short_code" model="ir.ui.view">
        <field name="name">product.category.form.short.code</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="short_code" style="width:100px;"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <header>

                    <!--  No-right users only: visible in Draft -->
                    <button
                            name="action_submit_for_approval"
                            string="Submit for Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="!dtech_inventory_modification.group_product_category_approve_advnta"
                    />

                    <!--  Has-right users only: visible in Draft and Waiting -->
                    <button
                            name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'waiting_approval')"
                            groups="dtech_inventory_modification.group_product_category_approve_advnta"
                    />

                    <!--  Has-right users only: visible in Approved state ONLY -->
                    <button
                            name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'approved'"
                            groups="dtech_inventory_modification.group_product_category_approve_advnta"
                    />

                    <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,waiting_approval,approved"
                    />
                </header>
            </xpath>

            <!-- Both hidden fields recomputed fresh on every form load -->
            <xpath expr="//sheet" position="inside">
                <field name="user_has_approval_right" invisible="1"/>
                <field name="fields_readonly" invisible="1"/>
            </xpath>

            <!-- Single readonly on sheet locks ALL fields for no-right users -->
            <xpath expr="//sheet" position="attributes">
                <attribute name="readonly">fields_readonly</attribute>
            </xpath>

        </field>
    </record>

    <record id="product_category_list_view_approval" model="ir.ui.view">
        <field name="name">product.category.list.approval</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field
                        name="state"
                        optional="show"
                        decoration-success="state == 'approved'"
                        decoration-warning="state == 'waiting_approval'"
                        decoration-muted="state == 'draft'"
                />
            </xpath>
        </field>
    </record>

    <!-- Filter categ_id on product.template to show approved categories only -->
    <record id="product_template_form_view_category_filter" model="ir.ui.view">
        <field name="name">product.template.form.category.approved.filter</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="domain">[('state', '=', 'approved')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>