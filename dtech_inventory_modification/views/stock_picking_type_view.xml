<odoo>
  <record id="view_picking_type_form_expiry_date" model="ir.ui.view">
    <field name="name">stock.picking.type.form.expiry.date</field>
    <field name="model">stock.picking.type</field>
    <field name="inherit_id" ref="stock.view_picking_type_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='analytic_costs']" position="after">
        <field name="use_expiration_date"
               widget="boolean_toggle"
               string="Expiry Date"/>
      </xpath>

    </field>
  </record>
</odoo>