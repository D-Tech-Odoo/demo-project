<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">product.category.reject.wizard.form</field>
        <field name="model">product.category.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Product Category">
                <field name="category_id" invisible="1"/>
                <group>
                    <field name="reason"
                           placeholder="Enter rejection reason..."
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>