<odoo>
    <record id="view_stock_quant_tree_inventory_editable_inherit_ref" model="ir.ui.view">
        <field name="name">stock.quant.inventory.tree.reference</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity']" position="after">
                <field name="adjustment_reason" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>