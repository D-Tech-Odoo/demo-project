<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_return_picking_form_inherited" model="ir.ui.view">
        <field name="name">stock.return.picking.form.inherited</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">



            <!-- Per-line reason column inside the return moves list -->
            <xpath expr="//field[@name='product_return_moves']/list" position="inside">
                <field name="line_return_reason" string="Return Reason" optional="show"/>
            </xpath>

            <!-- Common reason above the footer buttons -->
            <xpath expr="//footer" position="before">
                <group>
                    <field name="common_return_reason"
                           placeholder="Enter a common reason for this return..."/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>