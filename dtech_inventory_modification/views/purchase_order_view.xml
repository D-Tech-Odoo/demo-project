<odoo>
    <record id="purchase_order_form_inherit_sup_origin" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sup.origin</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="supplier_origin" widget="radio"/>
            </xpath>

        </field>
    </record>
</odoo>