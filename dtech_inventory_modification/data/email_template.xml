<odoo>
    <record id="email_template_min_stock" model="mail.template">
        <field name="name">Minimum Stock Alert</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="subject">Product Minimum Stock Level Alert: ${object.product_id.name}</field>
        <field name="email_from">${(user.email or '')}</field>

        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                <p>Hello,</p>
                <p>This is an automated alert. The following product has reached its <strong>minimum stock level</strong>:</p>

                <table border="1" cellpadding="8" cellspacing="0"
                       style="border-collapse: collapse; width: 100%; max-width: 600px;">
                    <tr style="background-color: #f2f2f2;">
                        <th style="text-align:left;">Product</th>
                        <th style="text-align:left;">On Hand Qty</th>
                        <th style="text-align:left;">Minimum Qty</th>
                        <th style="text-align:left;">Location</th>
                    </tr>
                    <tr>
                        <td>${object.product_id.name}</td>
<!--                        <td>${object.product_id.qty_available}</td>-->
                        <td>${object.qty_on_hand}</td>
                        <td>${object.product_min_qty}</td>
                        <td>${object.location_id.complete_name}</td>
                    </tr>
                </table>

                <p style="margin-top: 16px;">
                    Please review the stock levels and create a <strong>Purchase Order</strong> if required.
                </p>
                <p>Thank you.</p>
            </div>
        </field>
    </record>
</odoo>