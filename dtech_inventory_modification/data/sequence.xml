<odoo>
    <data noupdate="1">
        <record id="seq_product_internal_reference" model="ir.sequence">
            <field name="name">Product Internal Reference</field>
            <field name="code">product.internal.reference</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>

        <record id="seq_replacement_request" model="ir.sequence">
            <field name="name">Replacement Request</field>
            <field name="code">replacement.request</field>
            <field name="prefix">RR%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>