<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="return_res">
        <field name="name">Return Restrict</field>
    </record>

    <record id="group_return_user_custom" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="return_res"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_return_admin_custom" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="return_res"/>
        <field name="implied_ids" eval="[(4, ref('group_return_user_custom'))]"/>
    </record>

    <record id="group_exceed_qty_approver" model="res.groups">
        <field name="name">Exceed QTY Approver</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_backorder_cancel_approval" model="res.groups">
        <field name="name">Back Order Cancel Approval</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
